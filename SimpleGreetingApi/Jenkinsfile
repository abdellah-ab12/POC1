pipeline {
    agent any

    environment {
        HARBOR_REGISTRY   = "192.168.88.143"
        HARBOR_PROJECT    = "poc1"
        IMAGE_NAME        = "simplegreetingapi"
        IMAGE_TAG         = "${env.BUILD_NUMBER}"
        FULL_IMAGE        = "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${IMAGE_NAME}:${IMAGE_TAG}"
        HARBOR_CREDS      = credentials('harbor-creds')
        APP_DIR           = "SimpleGreetingApi"
    }

    stages {

        stage('Récupération du code source') {
            steps {
                git branch: 'main', url: 'https://github.com/abdellah-ab12/POC1.git'
            }
        }

        stage('Compilation de l\'application') {
            steps {
                dir("${APP_DIR}") {
                    sh "docker build --target build -t ${IMAGE_NAME}-build:${IMAGE_TAG} ."
                }
            }
        }

        stage('Construction de l\'image Docker') {
            steps {
                dir("${APP_DIR}") {
                    sh "docker build -t ${FULL_IMAGE} ."
                }
            }
        }

        stage('Publication de l\'image vers Harbor') {
            steps {
                sh """
                    echo \$HARBOR_CREDS_PSW | docker login ${HARBOR_REGISTRY} -u \$HARBOR_CREDS_USR --password-stdin
                    docker push ${FULL_IMAGE}
                """
            }
        }

        stage('Déclenchement du scan Trivy') {
            steps {
                sh """
                    curl -s -u \$HARBOR_CREDS_USR:\$HARBOR_CREDS_PSW -X POST \
                    http://${HARBOR_REGISTRY}/api/v2.0/projects/${HARBOR_PROJECT}/repositories/${IMAGE_NAME}/artifacts/${IMAGE_TAG}/scan
                """
            }
        }

        stage('Attente de la fin du scan') {
            steps {
                script {
                    def maxAttempts = 30
                    def attempt = 0
                    def scanStatus = ""

                    while (attempt < maxAttempts) {
                        scanStatus = sh(
                            script: """
                                curl -s -u \$HARBOR_CREDS_USR:\$HARBOR_CREDS_PSW \
                                "http://${HARBOR_REGISTRY}/api/v2.0/projects/${HARBOR_PROJECT}/repositories/${IMAGE_NAME}/artifacts/${IMAGE_TAG}?with_scan_overview=true" \
                                | python3 -c "import sys,json; d=json.load(sys.stdin); ov=d.get('scan_overview',{}); v=list(ov.values()); print(v[0]['scan_status'] if v else 'Pending')"
                            """,
                            returnStdout: true
                        ).trim()

                        echo "Statut du scan (tentative ${attempt + 1}/${maxAttempts}) : ${scanStatus}"

                        if (scanStatus == "Success" || scanStatus == "Error") {
                            break
                        }
                        sleep(time: 10, unit: 'SECONDS')
                        attempt++
                    }

                    if (scanStatus != "Success") {
                        error "Le scan Trivy n'a pas abouti correctement (statut final : ${scanStatus})"
                    }
                }
            }
        }

        stage('Quality Gate — vérification des vulnérabilités critiques') {
            steps {
                script {
                    def criticalCount = sh(
                        script: """
                            curl -s -u \$HARBOR_CREDS_USR:\$HARBOR_CREDS_PSW \
                            "http://${HARBOR_REGISTRY}/api/v2.0/projects/${HARBOR_PROJECT}/repositories/${IMAGE_NAME}/artifacts/${IMAGE_TAG}?with_scan_overview=true" \
                            | python3 -c "import sys,json; d=json.load(sys.stdin); ov=d.get('scan_overview',{}); v=list(ov.values()); print(v[0]['summary']['summary'].get('Critical',0) if v else 0)"
                        """,
                        returnStdout: true
                    ).trim().toInteger()

                    echo "Nombre de vulnérabilités Critical détectées : ${criticalCount}"

                    if (criticalCount > 0) {
                        error "Quality Gate échoué : ${criticalCount} vulnérabilité(s) Critical détectée(s). Publication bloquée."
                    } else {
                        echo "Quality Gate validé : aucune vulnérabilité Critical. Image conforme."
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline terminé avec succès : ${FULL_IMAGE} publiée et validée."
        }
        failure {
            echo "Pipeline échoué — voir les logs ci-dessus pour la cause."
        }
        always {
            sh "docker logout ${HARBOR_REGISTRY} || true"
        }
    }
}
