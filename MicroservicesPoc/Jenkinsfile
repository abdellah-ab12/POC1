import groovy.transform.Field

@Field
def SERVICES = [
    [name: 'users-api',         label: 'Users.Api',         path: 'MicroservicesPoc/src/Users.Api'],
    [name: 'orders-api',        label: 'Orders.Api',        path: 'MicroservicesPoc/src/Orders.Api'],
    [name: 'notifications-api', label: 'Notifications.Api', path: 'MicroservicesPoc/src/Notifications.Api'],
    [name: 'frontend',          label: 'Frontend',          path: 'MicroservicesPoc/frontend']
]

def runInParallel(Closure action) {
    def branches = [:]
    SERVICES.each { svc ->
        branches[svc.label] = {
            action(svc)
        }
    }
    parallel branches
}

pipeline {
    agent { label 'test-server' }

    environment {
        HARBOR_REGISTRY = "192.168.88.143"
        HARBOR_PROJECT  = "microservices"
        HARBOR_CREDS    = credentials('harbor-creds')
    }

    stages {

        stage('Initialisation des variables') {
            steps {
                script {
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}"
                }
            }
        }

        stage('Récupération du code source') {
            steps {
                retry(3) {
                    git branch: 'main', url: 'https://github.com/abdellah-ab12/POC1.git'
                }
            }
        }

        stage('Connexion à Harbor') {
            steps {
                sh "echo \$HARBOR_CREDS_PSW | docker login ${HARBOR_REGISTRY} -u \$HARBOR_CREDS_USR --password-stdin"
            }
        }

        stage('Construction des images Docker') {
            steps {
                script {
                    runInParallel { svc ->
                        dir(svc.path) {
                            echo "Build de ${svc.name}..."
                            if (svc.name == 'frontend') {
                                sh """
                                    docker build \
                                      --build-arg VITE_USERS_API_URL=http://192.168.88.144:5001 \
                                      --build-arg VITE_ORDERS_API_URL=http://192.168.88.144:5002 \
                                      --build-arg VITE_NOTIFICATIONS_API_URL=http://192.168.88.144:5003 \
                                      -t ${svc.name}:${env.IMAGE_TAG} .
                                """
                            } else {
                                sh "docker build -t ${svc.name}:${env.IMAGE_TAG} ."
                            }
                        }
                    }
                }
            }
        }

        stage('Scan Trivy local (avant publication)') {
            steps {
                script {
                    runInParallel { svc ->
                        def localImage = "${svc.name}:${env.IMAGE_TAG}"
                        def reportFile = "trivy-report-${svc.name}.json"
                        echo "Scan de ${svc.name}..."
                        sh "trivy image --format json --output ${reportFile} ${localImage}"
                        archiveArtifacts artifacts: "${reportFile}", allowEmptyArchive: true
                    }
                }
            }
        }

        stage('Quality Gate — vérification des vulnérabilités critiques') {
            steps {
                script {
                    runInParallel { svc ->
                        def reportFile = "trivy-report-${svc.name}.json"
                        def criticalCount = sh(
                            script: """
                                cat ${reportFile} | python3 -c "
import sys, json
data = json.load(sys.stdin)
count = 0
for result in data.get('Results', []):
    for vuln in result.get('Vulnerabilities', []) or []:
        if vuln.get('Severity') == 'CRITICAL':
            count += 1
print(count)
"
                            """,
                            returnStdout: true
                        ).trim().toInteger()

                        echo "${svc.name} : ${criticalCount} vulnérabilité(s) Critical détectée(s)"

                        if (criticalCount > 0) {
                            error "Quality Gate échouée pour ${svc.name} : ${criticalCount} vulnérabilité(s) Critical détectée(s). Image NON publiée."
                        }
                        echo "${svc.name} : Quality Gate validée."
                    }
                }
            }
        }

        stage('Publication des images vers Harbor') {
            steps {
                script {
                    runInParallel { svc ->
                        def localImage = "${svc.name}:${env.IMAGE_TAG}"
                        def fullImage  = "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${svc.name}:${env.IMAGE_TAG}"
                        echo "Publication de ${svc.name}..."
                        sh """
                            docker tag ${localImage} ${fullImage}
                            docker push ${fullImage}
                        """
                    }
                }
            }
        }

        stage('Signature des images avec Cosign') {
            steps {
                script {
                    runInParallel { svc ->
                        withCredentials([
                            file(credentialsId: 'cosign-private-key', variable: 'COSIGN_KEY_FILE'),
                            string(credentialsId: 'cosign-key-password', variable: 'COSIGN_PASSWORD')
                        ]) {
                            def fullImage = "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${svc.name}:${env.IMAGE_TAG}"
                            def digest = sh(
                                script: "docker inspect --format='{{index .RepoDigests 0}}' ${fullImage}",
                                returnStdout: true
                            ).trim()

                            echo "Signature de ${svc.name} — digest : ${digest}"

                            sh """
                                cosign sign --yes \
                                  --new-bundle-format=false \
                                  --use-signing-config=false \
                                  --registry-referrers-mode=legacy \
                                  --key \$COSIGN_KEY_FILE \
                                  ${digest}
                            """
                        }
                    }
                }
            }
        }

        stage('Vérification de la signature Cosign') {
            steps {
                script {
                    runInParallel { svc ->
                        withCredentials([
                            file(credentialsId: 'cosign-public-key', variable: 'COSIGN_PUB_FILE')
                        ]) {
                            def fullImage = "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/${svc.name}:${env.IMAGE_TAG}"
                            def digest = sh(
                                script: "docker inspect --format='{{index .RepoDigests 0}}' ${fullImage}",
                                returnStdout: true
                            ).trim()

                            echo "Vérification de ${svc.name}..."
                            sh "cosign verify --key \$COSIGN_PUB_FILE ${digest}"
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline terminé avec succès : les 4 images ont été construites, scannées, publiées et signées vers Harbor, tag ${env.IMAGE_TAG}."
        }
        failure {
            echo "Pipeline échoué — vérifier à quelle étape (build, scan, Quality Gate, publication ou signature)."
        }
        always {
            sh "docker logout ${HARBOR_REGISTRY} || true"
        }
    }
}
